---
import { Image } from 'astro:assets';
import SocialPill from "../components/SocialPill.astro";
import Github from "./iconos/Github.astro";
import Link from "./iconos/link.astro";

import techUniverseImg from '../assets/projects/techuniverse.png';
import skylinkImg from '../assets/projects/SkyLink-2.jpg';
import flickpickImg from '../assets/projects/flickpick.jpg';

const TAGS = {
  JAVASCRIPT: { name: "JavaScript", class: "bg-yellow-400/10 border-yellow-400/20 text-yellow-700 dark:text-yellow-300" },
  DOCKER:     { name: "Docker",     class: "bg-blue-600/10 border-blue-600/20 text-blue-700 dark:text-blue-300" },
  STRAPI:     { name: "Strapi",     class: "bg-indigo-500/10 border-indigo-500/20 text-indigo-700 dark:text-indigo-300" },
  PHP:        { name: "PHP",        class: "bg-violet-500/10 border-violet-500/20 text-violet-700 dark:text-violet-300" },
  LARAVEL:    { name: "Laravel",    class: "bg-red-500/10 border-red-500/20 text-red-700 dark:text-red-300" },
  MYSQL:      { name: "MySQL",      class: "bg-blue-500/10 border-blue-500/20 text-blue-700 dark:text-blue-300" },
  REACT:      { name: "React",      class: "bg-sky-500/10 border-sky-500/20 text-sky-700 dark:text-sky-300" },
  TAILWIND:   { name: "Tailwind",   class: "bg-cyan-500/10 border-cyan-500/20 text-cyan-700 dark:text-cyan-300" },
};

const PROJECTS = [
  {
    title: "TechUniverse",
    description:
      "Full-stack e-commerce for tech products — Laravel REST API with Swagger docs and a React + TypeScript SPA frontend with cart, wishlist, and local caching.",
    github: "https://github.com/Ivanrr462/TechUniverse",
    link: "https://tech-universe1.vercel.app/",
    image: techUniverseImg,
    tags: [TAGS.LARAVEL, TAGS.REACT, TAGS.TAILWIND],
  },
  {
    title: "SkyLink",
    description:
      "SPA for a fictional airline that lets users sign up, search for flights, and make bookings.",
    github: "https://github.com/Ivanrr462/SkyLink",
    image: skylinkImg,
    tags: [TAGS.JAVASCRIPT, TAGS.DOCKER, TAGS.STRAPI],
  },
  {
    title: "FlickPick",
    description:
      "Online video rental platform developed as a final degree project.",
    github: "https://github.com/Ivanrr462/FlickPick",
    image: flickpickImg,
    tags: [TAGS.PHP, TAGS.JAVASCRIPT, TAGS.MYSQL, TAGS.DOCKER],
  },
];

const FEATURED = PROJECTS[0];
const REST = PROJECTS.slice(1);
---

<div class="flex flex-col gap-4">
  <!-- Featured — bento large -->
  <article class="group relative overflow-hidden rounded-2xl border border-gray-200/70 dark:border-white/[0.07] bg-white/80 dark:bg-white/[0.03] backdrop-blur-sm hover:bg-white dark:hover:bg-white/[0.05] hover:border-gray-200 dark:hover:border-white/10 hover:shadow-[0_8px_24px_rgba(15,23,42,0.06)] dark:hover:shadow-none transition-all xl:flex xl:items-stretch">
    <div class="relative overflow-hidden xl:w-[56%] shrink-0 bg-gray-50 dark:bg-black/20">
      <Image
        alt={FEATURED.title}
        class="h-64 sm:h-72 xl:h-full w-full object-cover object-top transition duration-700 group-hover:scale-[1.02]"
        src={FEATURED.image}
      />
      <!-- very subtle gradient only at bottom for depth -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-transparent opacity-60 dark:from-black/20 pointer-events-none"></div>
      <span class="absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-white/90 dark:bg-black/60 backdrop-blur border border-black/5 dark:border-white/10 px-2.5 py-1 text-[11px] font-medium tracking-wide text-gray-700 dark:text-gray-200">
        <span class="size-1.5 rounded-full bg-emerald-500"></span> Featured
      </span>
    </div>

    <div class="flex flex-1 flex-col p-6 xl:p-7">
      <div class="flex-1">
        <h3 class="text-[20px] font-semibold tracking-[-0.02em] text-gray-900 dark:text-white">
          {FEATURED.title}
        </h3>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {FEATURED.tags.map((tag) => (
            <span class={`rounded-full border px-2.5 py-1 text-[11px] font-medium leading-none ${tag.class}`}>
              {tag.name}
            </span>
          ))}
        </div>
        <p class="mt-4 text-sm leading-6 text-gray-600 dark:text-gray-400 text-pretty">
          {FEATURED.description}
        </p>
      </div>

      <footer class="mt-6 flex flex-wrap items-center gap-2.5 pt-5 border-t border-gray-100 dark:border-white/5">
        {FEATURED.github && (
          <a href={FEATURED.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full bg-white dark:bg-white/[0.06] border border-gray-200 dark:border-white/10 text-gray-900 dark:text-white px-4 py-2 text-xs font-medium hover:bg-gray-50 dark:hover:bg-white/10 hover:border-gray-300 dark:hover:border-white/15 transition-colors">
            <Github class="size-3.5" />
            Code
          </a>
        )}
        {FEATURED.link && (
          <a href={FEATURED.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-900 px-4 py-2 text-xs font-medium hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors">
            <Link class="size-3.5" />
            Live Preview
          </a>
        )}
      </footer>
    </div>
  </article>

  <!-- Secondary — bento 2 cols -->
  <div class="grid gap-4 md:grid-cols-2">
    {REST.map(({ image, title, description, tags, github, link }, i) => (
      <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-gray-200/70 dark:border-white/[0.07] bg-white/80 dark:bg-white/[0.03] backdrop-blur-sm hover:bg-white dark:hover:bg-white/[0.05] hover:border-gray-200 dark:hover:border-white/10 hover:shadow-[0_8px_24px_rgba(15,23,42,0.06)] dark:hover:shadow-none transition-all">
        <div class="relative overflow-hidden bg-gray-50 dark:bg-black/20">
          <Image
            alt={title}
            class="h-48 sm:h-52 w-full object-cover object-top transition duration-700 group-hover:scale-[1.03]"
            src={image}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-transparent opacity-50 dark:from-black/20 pointer-events-none"></div>
        </div>

        <div class="flex flex-1 flex-col p-5">
          <h3 class="text-[17px] font-semibold tracking-[-0.02em] text-gray-900 dark:text-white">
            {title}
          </h3>

          <div class="mt-2.5 flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <span class={`rounded-full border px-2 py-0.5 text-[11px] font-medium leading-none ${tag.class}`}>
                {tag.name}
              </span>
            ))}
          </div>

          <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-400 text-pretty line-clamp-3">
            {description}
          </p>

          <footer class="mt-5 flex flex-wrap items-center gap-2 pt-4 border-t border-gray-100 dark:border-white/5">
            {github && (
              <a href={github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full bg-white dark:bg-white/[0.06] border border-gray-200 dark:border-white/10 text-gray-700 dark:text-gray-300 px-3.5 py-1.5 text-xs font-medium hover:bg-gray-50 dark:hover:bg-white/10 hover:text-gray-900 dark:hover:text-white transition-colors">
                <Github class="size-3.5" />
                Code
              </a>
            )}
            {link && (
              <a href={link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-900 px-3.5 py-1.5 text-xs font-medium hover:bg-gray-800 transition-colors">
                <Link class="size-3.5" />
                Preview
              </a>
            )}
          </footer>
        </div>
      </article>
    ))}
  </div>
</div>
