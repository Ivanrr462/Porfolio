---
import Laravel from "./iconos/Laravel.astro";
import Docker from "./iconos/Docker.astro";
import Php from "./iconos/php.astro";
import ReactIcon from "./iconos/react.astro";
import AstroLogo from "./iconos/AstroLogo.astro";
import JavaIcon from "./iconos/java.astro";
import MysqlIcon from "./iconos/mysql.astro";
import MongoIcon from "./iconos/mongo.astro";
import GitIcon from "./iconos/git.astro";
import TrelloIcon from "./iconos/trello.astro";
import AwsIcon from "./iconos/aws.astro";
import PostmanIcon from "./iconos/postman.astro";
import TailwindIcon from "./iconos/tailwind.astro";
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <!-- Frontend -->
  <div class="group rounded-2xl border border-gray-200/70 dark:border-white/[0.07] bg-white dark:bg-[#0e0e1a] p-5 hover:border-gray-300 dark:hover:border-white/15 hover:shadow-[0_8px_24px_rgba(15,23,42,0.06)] dark:hover:shadow-none transition-all">
    <div class="flex items-center gap-2.5 mb-3.5">
      <span class="size-7 grid place-items-center rounded-lg bg-sky-500/10 dark:bg-sky-500/15 text-sky-600 dark:text-sky-400 border border-sky-500/15">
        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </span>
      <h3 class="text-base font-semibold tracking-tight text-gray-900 dark:text-white">Frontend</h3>
    </div>
    <div class="flex flex-wrap gap-1.5">
      <span class="skill-badge"><ReactIcon class="size-3.5 shrink-0" />React</span>
      <span class="skill-badge"><TailwindIcon class="size-3.5 shrink-0" />Tailwind</span>
      <span class="skill-badge"><AstroLogo class="size-3.5 shrink-0" />Astro</span>
    </div>
  </div>

  <!-- Backend -->
  <div class="group rounded-2xl border border-gray-200/70 dark:border-white/[0.07] bg-white dark:bg-[#0e0e1a] p-5 hover:border-gray-300 dark:hover:border-white/15 hover:shadow-[0_8px_24px_rgba(15,23,42,0.06)] dark:hover:shadow-none transition-all">
    <div class="flex items-center gap-2.5 mb-3.5">
      <span class="size-7 grid place-items-center rounded-lg bg-violet-500/10 dark:bg-violet-500/15 text-violet-600 dark:text-violet-400 border border-violet-500/15">
        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
      </span>
      <h3 class="text-base font-semibold tracking-tight text-gray-900 dark:text-white">Backend</h3>
    </div>
    <div class="flex flex-wrap gap-1.5">
      <span class="skill-badge"><Php class="size-3.5 shrink-0" />PHP</span>
      <span class="skill-badge"><Laravel class="size-3.5 shrink-0" />Laravel</span>
      <span class="skill-badge"><JavaIcon class="size-3.5 shrink-0" />Java</span>
    </div>
  </div>

  <!-- Databases -->
  <div class="group rounded-2xl border border-gray-200/70 dark:border-white/[0.07] bg-white dark:bg-[#0e0e1a] p-5 hover:border-gray-300 dark:hover:border-white/15 hover:shadow-[0_8px_24px_rgba(15,23,42,0.06)] dark:hover:shadow-none transition-all">
    <div class="flex items-center gap-2.5 mb-3.5">
      <span class="size-7 grid place-items-center rounded-lg bg-blue-500/10 dark:bg-blue-500/15 text-blue-600 dark:text-blue-400 border border-blue-500/15">
        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
      </span>
      <h3 class="text-base font-semibold tracking-tight text-gray-900 dark:text-white">Databases</h3>
    </div>
    <div class="flex flex-wrap gap-1.5">
      <span class="skill-badge"><MysqlIcon class="size-3.5 shrink-0" />MySQL</span>
      <span class="skill-badge"><MongoIcon class="size-3.5 shrink-0" />MongoDB</span>
    </div>
  </div>

  <!-- DevOps -->
  <div class="group rounded-2xl border border-gray-200/70 dark:border-white/[0.07] bg-white dark:bg-[#0e0e1a] p-5 hover:border-gray-300 dark:hover:border-white/15 hover:shadow-[0_8px_24px_rgba(15,23,42,0.06)] dark:hover:shadow-none transition-all">
    <div class="flex items-center gap-2.5 mb-3.5">
      <span class="size-7 grid place-items-center rounded-lg bg-emerald-500/10 dark:bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/15">
        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </span>
      <h3 class="text-base font-semibold tracking-tight text-gray-900 dark:text-white">DevOps & Tools</h3>
    </div>
    <div class="flex flex-wrap gap-1.5">
      <span class="skill-badge"><Docker class="size-3.5 shrink-0" />Docker</span>
      <span class="skill-badge"><GitIcon class="size-3.5 shrink-0" />Git</span>
      <span class="skill-badge"><TrelloIcon class="size-3.5 shrink-0" />Trello</span>
      <span class="skill-badge"><AwsIcon class="size-3.5 shrink-0" />AWS</span>
      <span class="skill-badge"><svg class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M2 5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5zm3.293 1.293a1 1 0 0 0 0 1.414l3 3a1 1 0 0 0 1.414 0l3-3a1 1 0 1 0-1.414-1.414L9 8.586 7.707 7.293a1 1 0 0 0-1.414 0zM13 13a1 1 0 1 0 0 2h5a1 1 0 1 0 0-2h-5z"/></svg>Terminal</span>
      <span class="skill-badge"><PostmanIcon class="size-3.5 shrink-0" />Postman</span>
      <span class="skill-badge"><svg class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm-.39 17.682l-4.57-9.92 7.528 6.55-3.476.905.518-3.63zm.39-5.532L8.94 6.318l8.484 3.49-5.424 2.342z"/></svg>Ansible</span>
    </div>
  </div>
</div>

<style>
  .skill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border-radius: 9999px;
    border: 1px solid rgb(229 231 235);
    background: white;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgb(55 65 81);
    line-height: 1;
    transition: all 0.15s ease;
  }
  :global(html.dark) .skill-badge {
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.08);
    color: rgb(209 213 219);
  }
  .skill-badge:hover {
    border-color: rgb(209 213 219);
    background: rgb(249 250 251);
  }
  :global(html.dark) .skill-badge:hover {
    border-color: rgba(255,255,255,0.14);
    background: rgba(255,255,255,0.08);
  }
</style>
